# ------------------------------------------------------------------
#  Modèle de réglages personnels.
#  1. Copie ce fichier en le renommant exactement : .env
#  2. Remplis les valeurs ci-dessous.
#  Le fichier .env reste sur le NAS : il n'est jamais envoyé sur GitHub.
# ------------------------------------------------------------------

# Identifiant et mot de passe pour ouvrir le Chrome du NAS depuis ton PC.
# Ce ne sont PAS tes identifiants Leclerc, CCAS ou autre : invente-les.
# Pour le mot de passe : lettres, chiffres et tirets uniquement
# (évite les caractères spéciaux comme $ ou # qui posent problème ici).
CHROME_UTILISATEUR=moi
CHROME_MOT_DE_PASSE=remplace-moi-par-un-long-mot-de-passe

# Numéros de l'utilisateur du NAS qui possédera les fichiers créés.
# Sur un Synology, souvent PUID=1026 et PGID=100 (tape « id » en SSH
# pour connaître les tiens). Si tu ne sais pas, laisse 1000 : ça marche.
PUID=1000
PGID=1000

# Port pour ouvrir le Chrome : https://IP-DU-NAS:3001
# À changer seulement si 3001 est déjà utilisé sur ton NAS.
PORT_CHROME=3001
